PORT=3001

# --- OpenAI TTS ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1

# --- Microsoft Azure Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- Google Cloud TTS ---
GOOGLE_TTS_API_KEY=

# --- Coqui TTS (modèles mono-locuteur, un serveur par langue) ---
# ex. tts-server --model_name tts_models/fr/css10/vits --port 5003
COQUI_URL_FR=
COQUI_URL_EN=

# --- XTTS-v2 via tts-server (gratuit, local) ---
# tts-server --model_name tts_models/multilingual/multi-dataset/xtts_v2 --port 5002
XTTS_URL=http://localhost:5002
XTTS_SPEAKER_M=Damien Black
XTTS_SPEAKER_F=Claribel Dervla
